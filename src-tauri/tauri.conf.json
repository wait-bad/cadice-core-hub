{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadice Core Hub",
  "version": "1.0.0",
  "identifier": "dev.cadice.corehub",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "可黛丝中枢系统 · Cadice Core Hub",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ]
  }
}
